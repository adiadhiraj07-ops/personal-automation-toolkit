# Copy this file to .env and fill in real values. .env is gitignored.

# The Gmail address you're sending from.
GMAIL_SENDER=you@gmail.com

# Gmail requires an App Password, not your normal login password.
# Enable 2-Step Verification, then generate one at:
#   https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
