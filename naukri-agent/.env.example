# Naukri agent — optional local config.
# Copy this file to .env and adjust if you want to override the defaults.
# None of these are required to run the dry-run mode.

# Where the persistent logged-in Playwright browser profile is stored.
# Defaults to ".naukri-profile" next to the script if not set.
NAUKRI_PROFILE_DIR=.naukri-profile

# The local LLM endpoint used for screening-question answers is shared
# across agents — see ../shared/.env.example for OLLAMA_URL / OLLAMA_MODEL.
