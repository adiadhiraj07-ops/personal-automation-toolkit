# Shared config for both job-apply agents (loaded by job_apply_common.py).
# Copy to .env and `export` the values into your shell before running, or set
# them however your shell/process manager prefers -- the scripts read them via
# os.environ.get(), there is no .env auto-loader wired up.

# Local Ollama server endpoint used to answer free-text / pick-one screening
# questions. Defaults shown below match a stock local Ollama install.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:3b
